# Redes II - Configuración de Credenciales de Red
# Copia este archivo a `.env` e ingresa las credenciales reales de tu red Wi-Fi.
# `.env` está ignorado en Git para prevenir la fuga de secretos.

WIFI_SSID="MiRedWiFi"
WIFI_PASS="MiClaveSegura"

# Configuración IP del Servidor Web (opcional)
SERVER_IP="192.168.0.53"
SERVER_GATEWAY="192.168.0.1"
SERVER_MASK="255.255.255.0"
